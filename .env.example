# Copiez ce fichier en .env et remplissez les valeurs. NE COMMITEZ JAMAIS .env !
# Sur GitHub Actions : Settings > Secrets and variables > Actions (mêmes noms).

# --- Claude (https://console.anthropic.com/settings/keys) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- eBay API officielle (https://developer.ebay.com > Application Keys > Production) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Telegram (bot via @BotFather ; chat id via https://api.telegram.org/bot<TOKEN>/getUpdates) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord (optionnel) : Paramètres du salon > Intégrations > Webhooks ---
DISCORD_WEBHOOK_URL=
