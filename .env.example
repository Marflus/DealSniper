# Copiez ce fichier en .env et remplissez les valeurs.  NE COMMITEZ JAMAIS .env !
# Sur GitHub Actions, ces valeurs se mettent dans Settings > Secrets and variables > Actions.

# --- Anthropic (https://console.anthropic.com/settings/keys) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Boîte mail dédiée aux alertes (IMAP) ---
# Gmail : imap.gmail.com + « mot de passe d'application » (pas votre mot de passe normal)
# GMX : imap.gmx.com   |   OVH : ssl0.ovh.net
# Outlook/Hotmail : non compatible (Microsoft impose OAuth2) -> utilisez une boîte Gmail dédiée
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_EMAIL=mes.alertes.deals@gmail.com
IMAP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Telegram (optionnel) : bot créé via @BotFather, chat id via @userinfobot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord (optionnel) : Paramètres du salon > Intégrations > Webhooks ---
DISCORD_WEBHOOK_URL=

# --- Interface web (optionnel) ---
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=5000
