[Unit]
Description=Deal Sniper — veille continue (Xvfb)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1280x900x24" __DIR__/.venv/bin/python -m dealsniper watch
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target